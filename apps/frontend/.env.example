# Origin backend Express, tanpa /api/v1. Untuk release, isi origin HTTPS dari tim backend sebelum build.
API_INTERNAL_URL=http://localhost:4000

# Opsional. Kosongkan supaya browser memakai /api/v1 (diteruskan lewat rewrite).
NEXT_PUBLIC_API_URL=

# true = semua endpoint memakai data contoh dari desain, tanpa backend.
# false atau tidak diisi = semua request memakai HTTP asli, termasuk endpoint pending.
# pending: true hanya metadata kontrak; tidak mengaktifkan fallback mock.
NEXT_PUBLIC_API_MOCK=false

# Sandbox Midtrans untuk Snap di halaman bayar.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# "true" untuk Snap produksi, kosongkan untuk sandbox
NEXT_PUBLIC_MIDTRANS_PRODUCTION=
