{
  "name": "@gatherly/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-swagger-assets.mjs",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "tsx --test test/**/*.test.ts",
    "test:smoke:midtrans": "tsx --test test/midtrans-sandbox.smoke.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "format": "prettier --write",
    "format:check": "prettier --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.10.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "prettier": "3.6.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
