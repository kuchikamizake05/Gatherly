NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/gatherly
SESSION_TTL_DAYS=7
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_REQUEST_TIMEOUT_MS=8000
OTP_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-another-32-random-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Gatherly <your-email@gmail.com>
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:4000
ORGANIZER_ORIGIN=http://localhost:3000
WEB_ORIGINS=
COOKIE_DOMAIN=
ADMIN_ENCRYPTION_KEY=replace-with-64-hex-characters-and-never-change-it
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gatherly
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key

# Email admin wajib memakai domain ini.
ADMIN_EMAIL_DOMAIN=gatherlyy.fun
